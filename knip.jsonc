{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Let Knip's Next.js plugin auto-detect app/ routes (incl. route groups and
  // dynamic segments). Only declare entries Knip cannot discover on its own.
  "entry": [
    "build/sites-vite-plugin.ts",
    "worker/index.ts",
    "db/schema.ts",
    "db/index.ts",
    "tests/**/*.test.mjs"
  ],
  "ignore": [
    "Soumly-pages-comparaison-v2/**",
    "drizzle/meta/**",
    "references/**",
    "deploy/**",
    "scripts/**",
    "examples/**",
    "app/chatgpt-auth.ts",
    "app/products.ts"
  ],
  "ignoreDependencies": [
    "cloudflare",
    "tailwindcss",
    "@cloudflare/vite-plugin"
  ],
  "vite": {
    "config": ["vite.config.ts"]
  },
  "typescript": {
    "pathAlias": { "@/*": ["./*"] }
  }
}

