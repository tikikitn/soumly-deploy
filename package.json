{
	"name": "soumly-comparateur",
	"version": "1.0.0",
	"private": true,
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"install:ci": "bash scripts/install-ci.sh",
		"dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
		"build": "bash scripts/build-verified.sh",
		"start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
		"test": "npm run build && node --test tests/rendered-html.test.mjs",
		"validate:artifact": "bash scripts/validate-artifact.sh",
		"lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
		"biome:check": "biome check .",
		"biome:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"knip": "knip"
	},
	"dependencies": {
		"lucide-react": "^0.468.0",
		"next": "16.3.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@cloudflare/vite-plugin": "1.51.1",
		"@tailwindcss/postcss": "4.2.1",
		"@types/node": "22.19.19",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.5",
		"@vitejs/plugin-rsc": "0.5.34",
		"eslint": "9.39.4",
		"eslint-config-next": "16.3.0",
		"knip": "6.32.1",
		"react-server-dom-webpack": "19.2.8",
		"tailwindcss": "4.2.1",
		"typescript": "5.9.3",
		"vinext": "0.0.50",
		"vite": "8.2.1",
		"wrangler": "4.120.0"
	},
	"type": "module",
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.0": true,
		"esbuild@0.27.3": true,
		"workerd@1.20260515.1": true,
		"sharp@0.34.5": true,
		"unrs-resolver@1.11.1": true
	}
}
